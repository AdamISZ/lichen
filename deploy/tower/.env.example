# Copy to deploy/tower/.env.

# the contract's network: mutinynet, signet, testnet4 (regtest for tests)
NETWORK=mutinynet

# two Esplora servers, comma-separated, none trusted alone (a move is
# answered only once both report it confirmed, in the same block, with the
# same witness). On Mutinynet the same one twice will do for a trial.
ESPLORA=https://mutinynet.com/api,https://mutinynet.com/api

# the statement: groth16 (the real one: the tower proves) or mock
STATEMENT=groth16

# an absolute path on this machine for the Groth16 wrap's working files
R0WORK=/srv/lichen-tower/r0work
