# Copy to deploy/.env. One deployment per network: its data in
# deploy/state/<network>/, its own compose project (lichen-<network>).

# regtest, mutinynet, signet or testnet4
NETWORK=mutinynet

# the deployment's image (deploy/build.sh builds it): another tag tries
# a branch beside a running deployment's lichen:latest
#LICHEN_IMAGE=lichen:latest

# regtest only: COMPOSE_PROFILES=regtest adds a miner, a block every
# MINE_EVERY seconds
COMPOSE_PROFILES=
MINE_EVERY=5

# the statement an exit's dispute runs: the hub's proof that a claim is
# false, a real Groth16 proof checked by BABE (hub-proves), or a mock of
# it, a toy circuit's proof, for trials (hub-proves-mock)
STATEMENT=hub-proves

# an absolute path on this machine for the Groth16 wrap's working files
# (mounted at the same path in the hub's container): the hub proves its
# statement against false exit claims. Empty: deploy/lichen.sh uses
# deploy/state/<network>/r0work
R0WORK=

# the hub's terms: its reserve (ppm of the cap); its fee for a contract's
# liquidity (ppm of it, kept out of the user's minted deposit) and the
# most liquidity a contract may ask (sats); a contract's life in blocks
# (empty: the network's default, a week)
RESERVE_PPM=20000
FEE_PPM=10000
MAX_LIQUIDITY=10000000
DURATION=

# the L2: seconds between sealed heights; its history anchored on Bitcoin
# through the node (ANCHOR=off: not anchored; a ledger started so can never
# be), paid from the node's wallet ANCHOR_WALLET at ANCHOR_FEERATE sat/vB
SEAL_EVERY=5
ANCHOR=on
ANCHOR_WALLET=sequencer
ANCHOR_FEERATE=2

# for trials, on test networks only: any value makes the hub refuse every
# cooperative withdrawal and assert a forged proof against every exit
# claim, true ones too, so that users challenge and win
HOSTILE=
# for trials, on test networks only: any value makes the hub refuse every
# cooperative withdrawal but assert only against false claims, so a true
# claim is paid by timeout on chain
REFUSE_FOLDS=

# the published ports: the hub's and the sequencer's (wallets reach both)
HUB_PORT=18310
SEQUENCER_PORT=18300
