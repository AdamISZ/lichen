# Copy to deploy/.env. One deployment per network (each its own data in
# deploy/data/<network>/ and its own compose project).

# regtest, mutinynet, signet or testnet4
NETWORK=mutinynet

# the statement disputes run: groth16 (the real one) or mock
STATEMENT=groth16

# the hub's terms: reserve (ppm of the cap), the largest cap (2^bits - 1
# sats), a contract's life in blocks (empty: the network's default, a week)
RESERVE_PPM=20000
MAX_BITS=24
DURATION=

# seconds between the sequencer's sealed heights
SEAL_EVERY=5

# the ports the hub and the sequencer are published on
HUB_PORT=18310
SEQUENCER_PORT=18300

# regtest only: seconds between the miner's blocks
MINE_EVERY=5
