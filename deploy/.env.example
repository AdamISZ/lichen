# Copy to deploy/.env. One deployment per network: its data in
# deploy/state/<network>/, its own compose project (lichen-<network>).

# regtest, mutinynet, signet or testnet4
NETWORK=mutinynet

# regtest only: COMPOSE_PROFILES=regtest adds a miner, a block every
# MINE_EVERY seconds
COMPOSE_PROFILES=
MINE_EVERY=5

# the statement disputes run, a real Groth16 proof of the withdrawal
# checked by BABE (babe) or by BitVMX (bitvmx); or a mock of either
# (babe-mock, bitvmx-mock)
STATEMENT=babe

# an absolute path on this machine for the Groth16 wrap's working files
# (mounted at the same path in the hub's container): the hub proves
# counters to exit claims on the babe statement. Empty: deploy/lichen.sh
# uses deploy/state/<network>/r0work
R0WORK=

# the hub's terms: reserve (ppm of the cap), the largest cap (2^bits - 1
# sats), a contract's life in blocks (empty: the network's default, a week)
RESERVE_PPM=20000
MAX_BITS=24
DURATION=
# the dispute's windows in blocks, <user>,<hub>,<path> (empty: the network's
# default): the user's for each of her moves, the hub's for its choices, the
# hub's for its heavy moves; lengthen the user's and the heavy ones as the
# hub takes on more contracts
WINDOWS=

# the L2: seconds between sealed heights; its history anchored on Bitcoin
# through the node (ANCHOR=off: not anchored; a ledger started so can never
# be), paid from the node's wallet ANCHOR_WALLET at ANCHOR_FEERATE sat/vB
SEAL_EVERY=5
ANCHOR=on
ANCHOR_WALLET=sequencer
ANCHOR_FEERATE=2

# for trials, on test networks only: any value makes the hub refuse every
# cooperative withdrawal and dispute every claim, so each one is played on
# chain (a tower's test)
HOSTILE=
# for trials, on test networks only: any value makes the hub refuse every
# cooperative withdrawal but dispute only false claims, so a true claim
# ends unchallenged on chain
REFUSE_FOLDS=

# the published ports: the hub's and the sequencer's (wallets reach both)
HUB_PORT=18310
SEQUENCER_PORT=18300
