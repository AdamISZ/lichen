# Copy to deploy/hub/.env. One deployment per network (each its own data in
# deploy/hub/data/<network>/ and its own compose project).

# regtest, mutinynet, signet or testnet4
NETWORK=mutinynet

# the sequencer this hub mints on, as the hub's container reaches it: its
# operator gives the URL. A sequencer on this same machine:
# http://host.docker.internal:18300
SEQUENCER_URL=

# the statement disputes run: groth16 (the real one) or mock
STATEMENT=groth16

# the hub's terms: reserve (ppm of the cap), the largest cap (2^bits - 1
# sats), a contract's life in blocks (empty: the network's default, a week)
RESERVE_PPM=20000
MAX_BITS=24
DURATION=

# the port the hub is published on (wallets reach it)
HUB_PORT=18310

# regtest only: seconds between the miner's blocks
MINE_EVERY=5
