# Copy to deploy/hub/.env. One deployment per network (each its own data in
# deploy/hub/data/<network>/ and its own compose project).

# regtest, mutinynet, signet or testnet4
NETWORK=mutinynet

# the sequencer this hub mints on, as the hub's container reaches it: its
# operator gives the URL. A sequencer on this same machine:
# http://host.docker.internal:18300
SEQUENCER_URL=

# the statement disputes run, a real Groth16 proof of the withdrawal
# checked by BABE (babe) or by BitVMX (groth16); or a mock of either
# (babe-mock, mock)
STATEMENT=babe

# the hub's terms: reserve (ppm of the cap), the largest cap (2^bits - 1
# sats), a contract's life in blocks (empty: the network's default, a week)
RESERVE_PPM=20000
MAX_BITS=24
DURATION=
# the dispute's windows in blocks, <user>,<hub>,<path> (empty: the network's
# default, e.g. 80,20,80 on Mutinynet): the user's for each of her moves, the
# hub's for its choices, the hub's for its heavy moves; lengthen the user's
# and the heavy ones as the hub takes on more contracts
WINDOWS=

# for trials, on test networks only: any value makes the hub refuse every
# cooperative withdrawal and dispute every claim, so each one is played on
# chain (a tower's test)
HOSTILE=

# for trials, on test networks only: any value makes the hub refuse every
# cooperative withdrawal but dispute only false claims, so a true claim
# ends unchallenged on chain
REFUSE_FOLDS=

# the port the hub is published on (wallets reach it)
HUB_PORT=18310

# regtest only: seconds between the miner's blocks
MINE_EVERY=5
