# Copy to deploy/sequencer/.env.

# the network of the hub this sequencer serves. Only a label here: the
# sequencer has no chain. It names the data directory
# (deploy/sequencer/data/<network>/) and the compose project, so that one
# machine can run a sequencer per network.
NETWORK=mutinynet

# the hub's L2 key (x-only, hex), as the hub's operator gives it
# (`deploy/hub/hub.sh key`): the only key that may mint
ISSUER=

# seconds between sealed heights
SEAL_EVERY=5

# the port the sequencer is published on (the hub and every wallet reach it)
SEQUENCER_PORT=18300
